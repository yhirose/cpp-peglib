    'NCHAR'i / 'NONE'i / 'NULLIF'i / 'NUMERIC'i / 'OUT'i / 'OVERLAY'i / 'POSITION'i / 'PRECISION'i /
    'REAL'i / 'ROW'i / 'SETOF'i / 'SMALLINT'i / 'SUBSTRING'i / 'STRUCT'i / 'TIME'i / 'TIMESTAMP'i /
