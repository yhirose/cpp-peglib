    'SELECT'i / 'SHOW'i / 'SOME'i / 'SUMMARIZE'i / 'SYMMETRIC'i / 'TABLE'i / 'THEN'i / 'TO'i /
    'TRAILING'i / 'TRUE'i / 'UNION'i / 'UNIQUE'i / 'UNPIVOT'i / 'USING'i / 'VARIADIC'i / 'WHEN'i /
    'WHERE'i / 'WINDOW'i / 'WITH'i / 'BETWEEN'i / 'BIGINT'i / 'BIT'i / 'BOOLEAN'i / 'CHAR'i /
