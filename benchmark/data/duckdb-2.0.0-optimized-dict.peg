NonTypeNameKeyword <-
    'ALL'i / 'ANALYSE'i / 'ANALYZE'i / 'AND'i / 'ANY'i / 'ARRAY'i / 'AS'i / 'ASC'i /
    'ASYMMETRIC'i / 'BOTH'i / 'CASE'i / 'CAST'i / 'CHECK'i / 'COLLATE'i / 'COLUMN'i / 'CONSTRAINT'i /
