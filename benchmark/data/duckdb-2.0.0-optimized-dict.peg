# DuckDB's SQL grammar, ported to cpp-peglib.
# Generated by gen.py from src/include/duckdb/parser/peg/inlined_grammar.gram
# (DuckDB main, 80e17fc). CHANGES.md lists every change; grammar.diff is the diff.

Program <- TopLevelStatement*
TopLevelStatement <- Statement (';'+ / EndOfInput) / ';'+
Statement <-
	ExternalResourceStatement /
	ExtensionRepositoryStatement /
	CreateStatement /
	SelectStatement /
	SetStatement /
	PragmaStatement /
	CallStatement /
	InsertStatement /
	DropStatement /
	CopyStatement /
	ExplainStatement /
	UpdateStatement /
	PrepareStatement /
	ExecuteStatement /
	AlterStatement /
	TransactionStatement /
	DeleteStatement /
	AttachStatement /
	UseStatement /
	DetachStatement /
	CheckpointStatement /
	VacuumStatement /
	ResetStatement /
	ExportStatement /
	ImportStatement /
	CommentStatement /
	DeallocateStatement /
	TruncateStatement /
	LoadStatement /
	InstallStatement /
	UpdateExtensionsStatement /
	AnalyzeStatement /
	MergeIntoStatement /
	ConnectStatement /
	DisconnectStatement
AnalyzeKeyword <- 'ANALYZE'i / 'ANALYSE'i
CatalogName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
SchemaName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
ReservedSchemaName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
TableName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*> / StringLiteral
ReservedTableName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*> / StringLiteral
ReservedIdentifier <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
ColumnName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
ReservedColumnName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
IndexName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
ReservedIndexName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
SettingName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
PragmaName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
FunctionName <- QuotedIdentifier / !NonFunctionNameKeyword <[a-z_]i[a-z0-9_]i*>
ReservedFunctionName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
ReservedTypeName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
TableFunctionName <- QuotedIdentifier / !NonFunctionNameKeyword <[a-z_]i[a-z0-9_]i*>
ConstraintName <- ColIdOrString
SequenceName <- QuotedIdentifier / !NonIdentifierKeyword <[a-z_]i[a-z0-9_]i*>
CollationName <- Identifier
CopyOptionName <- QuotedIdentifier / <[a-z_]i[a-z0-9_]i*>
NumberLiteral <- < ([0-9]+ ([.] [0-9]*)? / [.] [0-9]+) ([eE] [-+]? [0-9]+)? >
StringLiteral <- < '\'' [^\']* ('\'\'' [^\']*)* '\'' >
Type <- TypeVariations ArrayBounds*
TypeVariations <- TimeType / IntervalType / BitType / RowType / VariantType / MapType / TupleType / GeometryType / UnionType / NumericType / SetofType / SimpleType
SimpleType <- CharacterSimpleType / QualifiedSimpleType
CharacterSimpleType <- CharacterType TypeModifiers?
QualifiedSimpleType <- QualifiedTypeName TypeModifiers?
CharacterType <- ('CHARACTER'i 'VARYING'i?) /
                 ('CHAR'i 'VARYING'i?) /
                 ('NATIONAL'i 'CHARACTER'i 'VARYING'i?) /
                 ('NATIONAL'i 'CHAR'i 'VARYING'i?) /
                 ('NCHAR'i 'VARYING'i?) /
                 'VARCHAR'i
IntervalType <- IntervalInterval / IntervalNumber
IntervalInterval <- IntervalWithSpecifier / IntervalWithoutSpecifier
IntervalWithSpecifier <- IntervalWithRangeSpecifier / IntervalWithSimpleSpecifier
IntervalWithRangeSpecifier <- 'INTERVAL'i IntervalToIntervalAsType
IntervalWithSimpleSpecifier <- 'INTERVAL'i Interval
IntervalWithoutSpecifier <- 'INTERVAL'i
IntervalToIntervalAsType <- (YearKeyword 'TO'i MonthKeyword) /
    (DayKeyword 'TO'i HourKeyword) /
    (DayKeyword 'TO'i MinuteKeyword) /
    (DayKeyword 'TO'i SecondKeyword) /
    (HourKeyword 'TO'i MinuteKeyword) /
    (HourKeyword 'TO'i SecondKeyword) /
    (MinuteKeyword 'TO'i SecondKeyword)
IntervalNumber <- 'INTERVAL'i Parens(NumberLiteral)
YearKeyword         <- 'YEAR'i / 'YEARS'i
MonthKeyword        <- 'MONTH'i / 'MONTHS'i
DayKeyword          <- 'DAY'i / 'DAYS'i
HourKeyword         <- 'HOUR'i / 'HOURS'i
MinuteKeyword       <- 'MINUTE'i / 'MINUTES'i
SecondKeyword       <- 'SECOND'i / 'SECONDS'i
MillisecondKeyword  <- 'MILLISECOND'i / 'MILLISECONDS'i
MicrosecondKeyword  <- 'MICROSECOND'i / 'MICROSECONDS'i
WeekKeyword         <- 'WEEK'i / 'WEEKS'i
QuarterKeyword      <- 'QUARTER'i / 'QUARTERS'i
DecadeKeyword       <- 'DECADE'i / 'DECADES'i
CenturyKeyword      <- 'CENTURY'i / 'CENTURIES'i
MillenniumKeyword   <- 'MILLENNIUM'i / 'MILLENNIA'i
Interval <- IntervalToInterval /
    YearKeyword /
    MonthKeyword /
    DayKeyword /
    HourKeyword /
    MinuteKeyword /
    SecondKeyword /
    MillisecondKeyword /
    MicrosecondKeyword /
    WeekKeyword /
    QuarterKeyword /
    DecadeKeyword /
    CenturyKeyword /
    MillenniumKeyword
IntervalToInterval <- YearToMonth /
    DayToHour /
    DayToMinute /
    DayToSecond /
    HourToMinute /
    HourToSecond /
    MinuteToSecond
YearToMonth <- YearKeyword 'TO'i MonthKeyword
DayToHour <- DayKeyword 'TO'i HourKeyword
DayToMinute <- DayKeyword 'TO'i MinuteKeyword
DayToSecond <- DayKeyword 'TO'i SecondKeyword
HourToMinute <- HourKeyword 'TO'i MinuteKeyword
HourToSecond <- HourKeyword 'TO'i SecondKeyword
MinuteToSecond <- MinuteKeyword 'TO'i SecondKeyword
BitType <- 'BIT'i 'VARYING'i? Parens(List(Expression))?
GeometryType <- 'GEOMETRY'i Parens(Expression)?
VariantType <- 'VARIANT'i
NumericType <- SimpleNumericType / DecimalNumericType
SimpleNumericType <- IntType / IntegerType / SmallintType /
                BigintType / RealType / BooleanType / DoubleType
DecimalNumericType <- FloatType / DecimalType / DecType / NumericModType
IntType <- 'INT'i
IntegerType <- 'INTEGER'i
SmallintType <- 'SMALLINT'i
BigintType <- 'BIGINT'i
RealType <- 'REAL'i
BooleanType <- 'BOOLEAN'i
DoubleType <- ('DOUBLE'i 'PRECISION'i)
FloatType <- 'FLOAT'i Parens(NumberLiteral)?
DecimalType <- 'DECIMAL'i TypeModifiers?
DecType <- 'DEC'i TypeModifiers?
NumericModType <- 'NUMERIC'i TypeModifiers?
QualifiedTypeName <- CatalogReservedSchemaTypeName / SchemaReservedTypeName / TypeNameAsQualifiedName
TypeNameAsQualifiedName <- TypeName
CatalogReservedSchemaTypeName <- &QualifierAhead CatalogQualification ReservedSchemaQualification+ ReservedTypeName
SchemaReservedTypeName <- &QualifierAhead SchemaQualification ReservedTypeName
TypeModifiers <- Parens(List(Expression)?)
NestedType <- TypeVariations ArrayBounds*
RowType <- RowOrStruct ColIdTypeList?
SetofType <- 'SETOF'i NestedType
UnionType <- 'UNION'i ColIdTypeList
ColIdTypeList <- Parens(List(ColIdType))
MapType <- 'MAP'i Parens(List(NestedType))?
TupleType <- 'TUPLE'i Parens(List(NestedType))
ColIdType <- ColId NestedType
ArrayBounds <- ArrayKeywordWithBounds / SquareBracketsArray / ArrayKeyword
ArrayKeyword <- 'ARRAY'i
ArrayKeywordWithBounds <- 'ARRAY'i SquareBracketsArray
SquareBracketsArray <- '[' Expression? ']'
TimeType <- TimeOrTimestamp TypeModifiers? TimeZone?
TimeOrTimestamp <- TimeTypeId / TimestampTypeId
TimeTypeId <- 'TIME'i
TimestampTypeId <- 'TIMESTAMP'i
TimeZone <- WithOrWithout 'TIME'i 'ZONE'i
WithOrWithout <- WithRule / WithoutRule
WithRule <- 'WITH'i
WithoutRule <- 'WITHOUT'i
RowOrStruct <- 'ROW'i / 'STRUCT'i
# internal definitions
%whitespace <- [ \t\n\r\v\f]*
List(D) <- D (',' D)* ','?
Parens(D) <- '(' D ')'
