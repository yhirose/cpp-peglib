    'XMLEXISTS'i / 'XMLFOREST'i / 'XMLNAMESPACES'i / 'XMLPARSE'i / 'XMLPI'i / 'XMLROOT'i / 'XMLSERIALIZE'i / 'XMLTABLE'i
